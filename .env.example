# 접근 PC 설정 예시. 복사해서 .env 를 만들고 값을 적으세요(PowerShell, 저장소 맨 위에서):
#   copy .env.example .env
#   notepad .env
# .env 는 git 에 올라가지 않아요(.gitignore, 커밋 검사). 비밀 값은 .env 에만 적고 이 파일에는 적지 마세요.
# 모양: 이름=값. 값을 비우면 안 쓴 것으로 쳐요. # 뒤는 설명이에요(값에 공백 뒤 # 이 들어가면 "따옴표" 로 감싸요).
# PowerShell 창에서 $env:이름 으로 먼저 정한 값이 있으면 그 값이 이겨요.

# ---- 한 번에 받기(pc\run_all.ps1) ----
# 차례로 할 작업: pack(기초 프로그램), docker(rootless Docker), datasets(데이터셋), models(모델). 비우면 넷 다 해요
B200_RUN=pack,docker,datasets,models

# ---- 회사망 ----
# 스크립트가 프록시를 스스로 찾지 못할 때만 적어요. 주소는 사내 IT에 물어요. 예: http://proxy.example.com:8080
HTTPS_PROXY=

# ---- 사전학습 모델(pc\models_download.ps1) ----
# 승인이 필요한 모델(gated)용 Hugging Face Read 토큰(hf_ 로 시작). 비우면 실행 중에 묻고, 그때도 비우면 그 모델만 건너뛰어요
# 만들기: https://huggingface.co/settings/tokens   약관 동의: docs\7_모델.md 의 "승인이 필요한 모델(gated) 받기"
HF_TOKEN=

# ---- 데이터셋 WildScenes(pc\datasets_download.ps1) ----
# 둘 중 하나만 적어요. 적으면 -WildScenes 를 붙이지 않아도 WildScenes 까지 받고, 접속 정보를 묻지 않아요.
# 자세한 것: docs\6_데이터셋.md 의 "WildScenes 접속 정보 받기"
# (1) 포털의 Download files via S3 Client 화면에 나온 네 값. 약 48시간만 유효해서, 지나면 새로 받아 고쳐 적어요
WILDSCENES_S3_SERVER=
WILDSCENES_S3_DIR=
WILDSCENES_ACCESS_KEY=
WILDSCENES_SECRET_KEY=
# (2) S3 방식이 안 되는 망: 포털에서 받은 링크 목록 .txt 의 경로. 예: %USERPROFILE%\Downloads\61541v001.txt
WILDSCENES_LINKS=

# 접근 PC(인터넷이 되는 PC) 설정 예시. 복사해서 .env 를 만들고 값을 적으세요(PowerShell, 저장소 맨 위에서):
#   copy .env.example .env
#   notepad .env
# .env 는 git 에 올라가지 않아요(.gitignore 와 커밋 검사가 막아요). 비밀 값은 .env 에만 적고 이 파일에는 적지 마세요.
# 모양: 이름=값. 값을 비우면 안 쓴 것으로 쳐요. # 뒤는 설명이에요(값에 공백 뒤 # 이 들어가면 "따옴표" 로 감싸요).
# PowerShell 창에서 $env:이름 으로 먼저 정한 값이 있으면 .env 보다 그 값을 먼저 써요.

# ---- 한 번에 받기(admin\pc\run_all.ps1) ----
# 차례로 할 작업: setup(서버 설치 스크립트), pkgs(서버 기초 프로그램), docker(관리자 권한 없이 도는 rootless Docker), datasets(데이터셋), models(모델). 비우면 다섯 다 해요
GPU_RUN=setup,pkgs,docker,datasets,models

# ---- 회사망 ----
# 스크립트가 프록시를 스스로 찾지 못할 때만 적어요. 주소는 사내 IT에 물어요. 예: http://proxy.example.com:8080
HTTPS_PROXY=

# ---- 사전학습 모델(user\pc\models_download.ps1) ----
# 승인이 필요한 모델(gated)용 Hugging Face Read 토큰(hf_ 로 시작). 비우면 실행 중에 묻고, 그때도 비우면 그 모델만 건너뛰어요
# 만들기: https://huggingface.co/settings/tokens   약관 동의: user\모델_넣기.md 의 "승인이 필요한 모델(gated) 받기"
HF_TOKEN=

# ---- 데이터셋 WildScenes(user\pc\datasets_download.ps1) ----
# 포털에서 받은 링크 목록 .txt 의 경로. 적으면 -WildScenesLinks 를 붙이지 않아도 WildScenes 까지 받아요. 예: %USERPROFILE%\Downloads\61541v003.txt
# 링크는 유효 기간이 있어서, 만료됐다고 나오면 포털에서 새로 받아 같은 이름으로 덮어쓰거나 이 경로를 고쳐요
# 받는 법: user\데이터셋_넣기.md 의 "WildScenes 링크 목록으로 받기"
WILDSCENES_LINKS=

# ---- 데이터셋 Cityscapes(user\pc\datasets_download.ps1) ----
# Cityscapes 회원 계정. 비우면 실행 중에 묻고, 그때도 비우면 Cityscapes 만 건너뛰어요
# 가입: https://www.cityscapes-dataset.com/register/ (가입 확인 메일의 링크를 눌러야 로그인돼요)
CITYSCAPES_USERNAME=
CITYSCAPES_PASSWORD=

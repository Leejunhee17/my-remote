#!/usr/bin/env bash
# 커밋 전에 사내 정보가 들어가지 않았는지 봐요. 저장소를 받은 뒤 한 번만 켜요: git config core.hooksPath .githooks
# 가릴 낱말(서버 이름, 계정 이름, NAS 주소, 팀 이름 등)은 저장소에 올라가지 않는 .git/info/gpu-blocklist.txt 에 한 줄에 하나씩 적어요.
bad=0
files=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$files" | grep -E '_report_'; then
    echo "[멈춤] 원본 보고서(_report_)는 올리지 마세요. 공유용(_공유용_)만 올려요."; bad=1
fi
if echo "$files" | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -vE '(^|/)\.env\.example$'; then
    echo "[멈춤] .env(토큰·키가 든 접근 PC 설정)는 올리지 마세요. 예시는 .env.example 에 값 없이 적어요."; bad=1
fi
added=$(git diff --cached -U0 --diff-filter=ACM -- . ':(exclude)*.xlsx' | grep '^+' | grep -v '^+++')
# 엑셀은 압축(zip) 안의 xml 이라 글자를 꺼내서 같이 본다(perl 은 Git for Windows 에도 들어 있다)
while IFS= read -r -d '' f; do
    case "$f" in *.xlsx|*.XLSX) ;; *) continue ;; esac
    added+=$'\n'$(git show ":$f" | perl -MIO::Uncompress::Unzip -MEncode -e '
        binmode STDOUT, ":utf8"; my $z = IO::Uncompress::Unzip->new(\*STDIN) or exit 0; my $st = 1;
        while ($st > 0) { my $n = $z->getHeaderInfo->{Name}; my $d = join "", <$z>;
            if ($n =~ /\.xml$/) { $d = decode("UTF-8", $d); $d =~ s/<[^>]+>/\n/g;
                $d =~ s/&#x([0-9a-f]+);/chr hex $1/gei; $d =~ s/&#(\d+);/chr $1/ge; print "$d\n" }
            $st = $z->nextStream }' | grep . | sed "s|^|$f: |")
done < <(git -c core.quotepath=false diff --cached --name-only -z --diff-filter=ACM)
if echo "$added" | grep -nE '(^|[^0-9.])(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)'; then
    echo "[멈춤] 사내 IP처럼 보이는 줄이 있어요."; bad=1
fi
# 토큰·키처럼 보이는 값(Hugging Face, GitHub, AWS, 개인 키)
tok=$(echo "$added" | grep -nE 'hf_[A-Za-z0-9]{30,}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,}|(AKIA|ASIA)[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY')
if [ -n "$tok" ]; then
    echo "$tok" | cut -c1-40
    echo "[멈춤] 토큰이나 키처럼 보이는 값이 있어요(위는 앞부분만). .env 에만 적으세요."; bad=1
fi
list=$(git rev-parse --git-path info/gpu-blocklist.txt)
if [ -s "$list" ] && echo "$added" | grep -inF -f <(grep -v '^[[:space:]]*#' "$list" | grep .); then
    echo "[멈춤] 가릴 낱말($list)이 들어 있어요."; bad=1
fi
[ -s "$list" ] || echo "[주의] 가릴 낱말 목록이 없어서 서버·계정 이름은 확인하지 못했어요: $list (admin/4_네트워크.md 의 \"결과 가져오기\")"
[ "$bad" = 0 ] || { echo "커밋을 멈췄어요. 위 줄을 고치거나 가린 뒤 다시 커밋하세요."; exit 1; }

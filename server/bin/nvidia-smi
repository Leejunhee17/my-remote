#!/usr/bin/env bash
# GPU 서버의 nvidia-smi. 관리자가 /app/admin/bin/nvidia-smi 에 설치한다(6단계 admin_setup.sh).
# 옵션 없이 화면에서 실행하면 원래 표 아래에 "GPU별 사용자" 표(이름, 컨테이너)를 붙인다. 옵션이 있으면 원래 그대로.
REAL=${GPU_NVSMI:-/usr/bin/nvidia-smi}
if [ $# -eq 0 ] && [ -t 1 ]; then
    "$REAL"; rc=$?
    "${GPU_APP:-/app}/admin/bin/gpu" who 2>/dev/null
    exit $rc
fi
exec "$REAL" "$@"

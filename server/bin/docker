#!/usr/bin/env bash
# B200 서버의 docker. 관리자가 /app/shared/bin/docker 에 깐다(admin_setup.sh). 팀원은 평소처럼 docker 를 쓴다.
# 진짜 docker 를 부르기 전후로 두 가지만 더 한다. 막지는 않는다.
#   - run·create: 컨테이너에 이름표(b200.USER=내 이름, b200.GPUS=GPU)를 붙인다. 남이 쓰는 GPU면 경고하고 한 번 묻는다
#   - load·build·commit·import: 새로 생긴 이미지를 누가 들여왔는지 적어 둔다(오래 안 쓰면 그 사람에게 알림)
APP=${B200_APP:-/app}
S=$APP/shared
REAL=${B200_DOCKER:-/opt/b200/docker/current/docker}
if [ ! -x "$REAL" ]; then
    self=$(readlink -f "$0"); REAL=
    for d in $(type -ap docker); do [ "$(readlink -f "$d")" = "$self" ] || { REAL=$d; break; }; done
    [ -n "$REAL" ] || { echo "docker 가 아직 설치되지 않았어요. 관리자에게 문의하세요." >&2; exit 127; }
fi
[ "$(id -u)" = 0 ] && exec "$REAL" "$@"
ME=${B200_USER:-}

pre=(); sub=${1:-}
case "$sub" in container|image|buildx) pre=("$1"); shift; sub=${1:-} ;; esac

case "${pre[0]:-}:$sub" in
    :run|:create|container:run|container:create)
        shift
        # --gpus 값(첫 번째)만 본다: '"device=3,4"' | device=3 | all | 2
        gspec=; prev=
        for a in "$@"; do
            [ "$prev" = --gpus ] && { gspec=$a; break; }
            case $a in --gpus=*) gspec=${a#--gpus=}; break ;; esac
            prev=$a
        done
        labels=()
        if [ -n "$gspec" ]; then
            v=${gspec//\"/}; v=${v//\'/}
            if [[ "$v" =~ device=([0-9,]+) ]]; then spec=${BASH_REMATCH[1]}
            elif [ "$v" = all ]; then spec=all
            elif [[ "$v" =~ ^[0-9]+$ ]]; then spec=n$v
            else spec=; fi
            if [ -n "$spec" ]; then
                labels+=(--label "b200.GPUS=$( [ "${spec#n}" != "$spec" ] && echo "앞 ${spec#n}장" || echo "$spec")")
                "$S/bin/b200" _gpu-warn "$spec"
                if [ $? = 2 ] && [ -t 0 ] && [ -t 2 ]; then
                    read -r -p "  그래도 실행할까요? [y/N] " ans
                    [[ "$ans" =~ ^[yY] ]] || { echo "  실행하지 않았어요." >&2; exit 1; }
                fi
            fi
        fi
        [ -n "$ME" ] && labels+=(--label "b200.USER=$ME")
        exec "$REAL" "${pre[@]}" "$sub" "${labels[@]}" "$@"
        ;;
    :load|image:load|:build|image:build|buildx:build|:commit|container:commit|:import|image:import)
        before=$("$REAL" images --no-trunc --format '{{.ID}} {{.Repository}}:{{.Tag}}' 2>/dev/null | sort)
        "$REAL" "${pre[@]}" "$@"; rc=$?
        if [ $rc = 0 ] && [ -n "$ME" ] && [ -w "$APP/state/images" ]; then
            comm -13 <(echo "$before") <("$REAL" images --no-trunc --format '{{.ID}} {{.Repository}}:{{.Tag}}' 2>/dev/null | sort) |
                awk '$2 !~ /^<none>/ {print $2}' | while read -r ref; do
                    printf '%s\t%s\t%s\n' "$(date '+%F %T')" "$ME" "$ref" >> "$APP/state/images/loaded.tsv"
                done
        fi
        exit $rc
        ;;
esac
exec "$REAL" "${pre[@]}" "$@"

#!/usr/bin/env bash
# B200 서버 도우미. 관리자가 /app/shared/bin/b200 에 깐다(admin_setup.sh). 팀원이 외울 명령이 아니다.
# 팀원은 docker, nvidia-smi 를 평소처럼 쓰고, 이 파일은 그 뒤에서 다음을 맡는다.
#   - 접속 인사: 이름 고르기, GPU별 쓰는 사람, 나에게 온 알림
#   - nvidia-smi 아래 "누가 쓰나" 표, docker run 의 GPU 겹침 경고
#   - 정기 점검(10분): 사용 기록과 알림(겹침, 놀고 있는 GPU, 디스크, 오래된 이미지). 멈추거나 지우지는 않는다
#   - 주간 보고서(관리자)
# 공용 계정 하나로 여럿이 쓰므로, 접속할 때 고른 이름(B200_USER)으로 사람을 구분한다.
set -uo pipefail
export LC_ALL=C.UTF-8   # 한글 이름의 화면 폭 계산과 tmux·도커 출력
APP=${B200_APP:-/app}   # 시험할 때만 바꾼다
S=$APP/shared
W=$APP/workspace
ST=$APP/state
ACC=${B200_ACCOUNT:-shareduser}
TEAM=$S/team.txt
ALLOC=$S/gpu_alloc.txt
NOTE=$ST/notice          # 알림: root(정기 점검)만 쓰는 곳
SEEN=$ST/notice_seen     # 팀원이 어디까지 봤는지: 공용 계정이 쓰는 곳. root 는 여기를 읽거나 쓰지 않는다
USED=$ST/gpu_log/images_used.tsv   # 이미지를 마지막으로 쓴 날: root 만 쓰는 곳(공용 계정 폴더에 root 가 쓰면 링크로 시스템 파일을 덮을 수 있다)
ME=${B200_USER:-}
# 관리자가 정하는 숫자(/app/shared/b200.conf 가 있으면 그 값). 모두 알림 기준이다
MAX_GPUS=4; IDLE_HOURS=12; DISK_ALERT=85; IMAGE_NOTICE_DAYS=30
[ -r "$S/b200.conf" ] && . "$S/b200.conf"
NVSMI=${B200_NVSMI:-/usr/bin/nvidia-smi}
c_g=$'\e[32m'; c_y=$'\e[33m'; c_r=$'\e[31m'; c_b=$'\e[1m'; c_0=$'\e[0m'
is_root() { [ "$(id -u)" = 0 ]; }

# ------------------------------------------------------------------ 명단·배분
members()   { [ -f "$TEAM" ] && grep -vE '^\s*(#|$)' "$TEAM" | awk '{print $1}'; }
group_of()  { [ -f "$TEAM" ] && awk -v n="$1" '!/^\s*#/ && $1==n {print $2; exit}' "$TEAM"; }
alloc_of()  { [ -f "$ALLOC" ] && awk -v g="$1" '!/^\s*#/ && $1==g {print $2; exit}' "$ALLOC"; }
# 다른 팀과 같이 쓰는 서버(서버 2): gpu_alloc.txt 에서 그룹이 '다른팀' 인 GPU 는 우리 팀이 쓰지 않는다
OTHER=다른팀
other_gpus() { [ -f "$ALLOC" ] && awk -v o="$OTHER" '!/^\s*#/ && $2==o {print $1}' "$ALLOC"; }
is_other()   { [ "$(alloc_of "$1")" = "$OTHER" ]; }
is_member() {
    [ -n "$1" ] || return 1
    case "$1" in *-*|*/*|*' '*) return 1 ;; esac
    [ -n "$(members)" ] || return 0          # 명단이 비어 있으면(처음 설정할 때만) 아무 이름이나 받는다
    members | grep -qxF "$1"
}
# 번호나 이름 → 이름
resolve_name() {
    local a=$1
    if [[ "$a" =~ ^[0-9]+$ ]]; then a=$(members | sed -n "${a}p"); fi
    is_member "$a" && echo "$a"
}

# ------------------------------------------------------------------ 도커(진짜 docker 를 바로 부른다)
if is_root && id "$ACC" >/dev/null 2>&1 && [ -z "${B200_DOCKER:-}" ]; then
    DOCKER=(runuser -u "$ACC" -- env DOCKER_HOST="unix:///run/user/$(id -u "$ACC")/docker.sock" /opt/b200/docker/current/docker)
else
    DOCKER=(${B200_DOCKER:-/opt/b200/docker/current/docker})
fi
HAVE_DOCKER=; "${DOCKER[@]}" version --format '{{.Server.Version}}' >/dev/null 2>&1 && HAVE_DOCKER=1

# 실행 중인 컨테이너: "pid<TAB>이름<TAB>사람<TAB>GPU<TAB>이미지"
# GPU 는 3,4 | all | n2(앞에서 2장) | -(없음). 사람은 docker 래퍼가 붙인 이름표(b200.USER)
CONTAINERS=
load_containers() {
    [ -n "$HAVE_DOCKER" ] || return 0
    local ids; ids=$("${DOCKER[@]}" ps -q 2>/dev/null); [ -n "$ids" ] || return 0
    # shellcheck disable=SC2086
    CONTAINERS=$("${DOCKER[@]}" inspect -f '{{.State.Pid}}{{"\t"}}{{slice .Name 1}}{{"\t"}}{{printf "%q" (index .Config.Labels "b200.USER")}}{{"\t"}}{{range .HostConfig.DeviceRequests}}{{if .DeviceIDs}}{{join .DeviceIDs ","}}{{else if eq .Count -1}}all{{else}}n{{.Count}}{{end}}{{end}}{{"\t"}}{{printf "%q" .Config.Image}}{{"\t"}}{{printf "%q" (index .Config.Labels "b200.GPUS")}}' $ids 2>/dev/null |
        # 이름표는 누구나 아무 글자(줄바꿈 포함)나 넣을 수 있다. %q 로 한 줄로 받고, 모양이 맞는 줄만 쓴다(root 가 읽는다)
        # GPU 요청 정보가 비어 있으면 이름표(b200.GPUS)로 본다
        awk -F'\t' -v OFS='\t' 'NF==6 && $1 ~ /^[0-9]+$/ {
            gsub(/^"|"$/, "", $3); gsub(/^"|"$/, "", $5); gsub(/^"|"$/, "", $6)
            if ($3 ~ /[\\"]/) $3="?"; if ($5 ~ /[\\"]/) $5="?"
            if ($4=="" && $6 ~ /^[0-9,]+$/) $4=$6
            NF=5; print}')
}
gpu_count() { "$NVSMI" -L 2>/dev/null | grep -c '^GPU'; }
# 3,4 | all | n2 → GPU 번호들(줄마다 하나)
# 값은 도커(공용 계정이 돌린다)에서 오므로 숫자 모양만 받는다. 계산식에 넣으면 그 안의 명령이 실행된다
expand_gpus() {
    case "$1" in
        all) seq 0 $(( $(gpu_count) - 1 )) ;;
        n*)  [[ "$1" =~ ^n[0-9]{1,2}$ ]] && seq 0 $(( 10#${1#n} - 1 )) ;;
        ''|-) ;;
        *)   echo "$1" | tr ',' '\n' | grep -xE '[0-9]{1,2}' ;;
    esac
    return 0
}

# ------------------------------------------------------------------ GPU 프로세스 → 사람
# ① 컨테이너 안 프로세스면 그 컨테이너의 이름표 ② 프로세스 환경의 B200_USER(접속할 때 고른 이름이 따라간다)
# ③ 작업 폴더 이름 순서로 찾는다. 결과는 "사람 어디(컨테이너 이름이나 -)"
owner_of_pid() {
    local pid=$1 p=$1 u cwd line i
    for i in $(seq 1 40); do
        [ "$p" -gt 1 ] 2>/dev/null || break
        line=$(echo "$CONTAINERS" | awk -F'\t' -v p="$p" '$1==p' | head -1)
        if [ -n "$line" ]; then
            u=$(echo "$line" | cut -f3); echo "${u:-?} $(echo "$line" | cut -f2)"; return
        fi
        p=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | cut -d' ' -f2)
    done
    u=$( { tr '\0' '\n' < "/proc/$pid/environ"; } 2>/dev/null | sed -n 's/^B200_USER=//p' | head -1)
    if [ -z "$u" ]; then
        cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null)
        case "$cwd" in "$W"/*) u=${cwd#"$W"/}; u=${u%%/*} ;; esac
    fi
    echo "${u:-?} -"
}
# 한 줄에 "gpu pid 메모리MiB 사람 어디"
gpu_procs() {
    local map oth; oth=" $(other_gpus | tr '\n' ' ')"
    map=$("$NVSMI" --query-gpu=index,uuid --format=csv,noheader 2>/dev/null)
    "$NVSMI" --query-compute-apps=gpu_uuid,pid,used_memory --format=csv,noheader,nounits 2>/dev/null |
        while IFS=', ' read -r uuid pid mem; do
            [ -n "$pid" ] || continue
            local g; g=$(echo "$map" | awk -F', ' -v u="$uuid" '$2==u {print $1}')
            # 다른 팀 GPU 의 다른 계정 프로세스는 들여다보지 않는다(우리 공용 계정 것만 주인을 찾는다)
            case "$oth" in *" $g "*) [ "$(stat -c %U "/proc/$pid" 2>/dev/null)" = "$ACC" ] || continue ;; esac
            echo "$g $pid $mem $(owner_of_pid "$pid")"
        done
}
# GPU 마다 "gpu 사람 어디" (프로세스 + GPU를 잡은 컨테이너. 아직 GPU를 안 써도 잡은 것으로 본다)
USAGE=
load_usage() {
    load_containers
    USAGE=$( { gpu_procs | awk '{print $1, $4, $5}'
               echo "$CONTAINERS" | while IFS=$'\t' read -r _ name who gpus _; do
                   [ -n "$name" ] || continue
                   for g in $(expand_gpus "$gpus"); do echo "$g ${who:-?} $name"; done
               done; } | grep . |
             # 다른 팀 GPU 에서 주인을 모르는 프로세스는 다른 팀 것이다(우리 이름표·이름이 없다). 우리 것만 남긴다
             awk -v o="$(other_gpus | tr '\n' ' ')" 'BEGIN {n = split(o, a, " "); for (i = 1; i <= n; i++) x[a[i]] = 1}
                 !(($1 in x) && $2 == "?" && $3 == "-")' | sort -u -k1,1n -k2,2 -k3,3)
}
users_of() { echo "$USAGE" | awk -v g="$1" '$1==g {print $2}' | sort -u; }   # GPU 하나를 쓰는 사람들
my_gpus()  { echo "$USAGE" | awk -v me="$1" '$2==me {print $1}' | sort -un; }

# 화면 폭(한글은 두 칸)에 맞춰 채운다
pad() { local w; w=$(printf '%s' "$1" | wc -L); printf '%s%*s' "$1" $(( $2 > w ? $2 - w : 0 )) ''; }

# ------------------------------------------------------------------ 누가 쓰나 (nvidia-smi 아래, 접속 인사)
cmd_who() {
    "$NVSMI" -L >/dev/null 2>&1 || { echo "${c_y}GPU 정보를 읽지 못했어요(nvidia-smi). 관리자에게 알려 주세요.${c_0}"; return; }
    load_usage
    echo "${c_b}누가 쓰나${c_0}  (공용 계정이라 접속할 때 고른 이름으로 보여요)"
    echo "$(pad GPU 4)$(pad 배분 15)$(pad '쓰는 사람' 16)$(pad 사용률 7)$(pad '메모리 GB' 10)컨테이너"
    "$NVSMI" --query-gpu=index,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits |
    while IFS=', ' read -r i mu mt ut; do
        local grp who where col='' u n
        grp=$(alloc_of "$i"); grp=${grp:--}
        who=$(users_of "$i" | tr '\n' ',' | sed 's/,$//')
        where=$(echo "$USAGE" | awk -v g="$i" '$1==g && $3!="-" {print $3}' | sort -u | tr '\n' ',' | sed 's/,$//')
        n=$(users_of "$i" | grep -c .)
        if [ "$grp" = "$OTHER" ]; then grp='다른 팀'; [ -n "$who" ] && { col=$c_r; who="$who(다른팀)"; }
        elif [ "$n" -ge 2 ]; then col=$c_r; who="$who(겹침)"
        elif [ "$who" = '?' ]; then col=$c_r; who='?(이름 없음)'
        elif [ -n "$who" ] && [ "$grp" != 공용 ] && [ "$grp" != - ] && [ "$(group_of "$who")" != "$grp" ]; then col=$c_y; who="$who(빌림)"
        fi
        echo "$(pad "$i" 4)$(pad "$grp" 15)$col$(pad "${who:--}" 16)$c_0$(pad "$ut%" 7)$(pad "$((mu / 1024))/$((mt / 1024))" 10)${where:--}"
    done
    echo "  빈 GPU를 골라 docker run --gpus '\"device=번호\"' 나 CUDA_VISIBLE_DEVICES=번호 로 쓰세요. 내 그룹·공용 먼저."
    local oth; oth=$(other_gpus | tr '\n' ',' | sed 's/,$//')
    [ -z "$oth" ] || echo "  ${c_y}GPU ${oth}번은 다른 팀 GPU예요. 우리 팀은 쓰지 않아요.${c_0}"
}

# ------------------------------------------------------------------ docker 래퍼가 부른다: GPU 겹침 경고
# $1: 3,4 | all | n2.  경고만 한다. 남이 쓰는 GPU 면 2 를 돌려줘(래퍼가 한 번 묻는다)
cmd__gpu_warn() {
    local spec=$1 g others grp mygrp rc=0 mine cnt free oth=
    load_usage
    mygrp=$(group_of "$ME")
    w() { echo "  ${c_y}[경고]${c_0} $*" >&2; }
    [ "$spec" = all ] && { w "GPU ${c_b}8장 모두${c_0}를 잡아요. 다른 사람과 겹쳐요."; rc=2; }
    case "$spec" in n*) w "--gpus ${spec#n} 처럼 장 수만 쓰면 0번부터 ${spec#n}장을 잡아요. 번호로 정하세요: --gpus '\"device=5\"'" ;; esac
    for g in $(expand_gpus "$spec"); do
        if is_other "$g"; then oth="$oth$g,"; continue; fi
        others=$(users_of "$g" | grep -vxF "${ME:-}" | tr '\n' ',' | sed 's/,$//')
        if [ -n "$others" ]; then
            w "GPU ${g}번은 지금 ${c_b}${others}${c_0} 님이 쓰고 있어요. 같이 쓰면 메모리가 모자라 둘 다 멈출 수 있어요."; rc=2
        fi
        grp=$(alloc_of "$g")
        if [ "$spec" != all ] && [ -n "$grp" ] && [ "$grp" != 공용 ] && [ -n "$mygrp" ] && [ "$grp" != "$mygrp" ]; then
            w "GPU ${g}번은 '$grp' 그룹 GPU예요. 비어 있을 때 빌려 쓰고, 그 그룹이 말하면 돌려주세요."
        fi
    done
    [ -z "$oth" ] || { w "GPU ${oth%,}번은 ${c_b}다른 팀${c_0} GPU예요. 우리 팀은 쓰지 않아요."; rc=2; }
    if [ -n "$ME" ] && [ "$spec" != all ]; then
        mine=$( { my_gpus "$ME"; expand_gpus "$spec"; } | sort -un | grep -c .)
        [ "$mine" -gt "$MAX_GPUS" ] && w "이걸 띄우면 내가 쓰는 GPU가 ${mine}장이에요(한 사람 ${MAX_GPUS}장까지가 약속)."
    fi
    if [ "$rc" = 2 ]; then
        free=$(for g in $(seq 0 $(( $(gpu_count) - 1 ))); do
                   [ -z "$(users_of "$g")" ] && ! is_other "$g" || continue
                   grp=$(alloc_of "$g"); { [ "$grp" = 공용 ] || [ -z "$grp" ] || [ "$grp" = "$mygrp" ]; } && echo "$g"
               done | tr '\n' ' ')
        echo "  내 그룹·공용의 빈 GPU: ${free:-없음}  (현황: nvidia-smi)" >&2
    fi
    return $rc
}

# ------------------------------------------------------------------ 알림
# 같은 알림(키)은 한 번만 보낸다. 사람별 파일에 남기고(접속할 때 보여 줌), 열려 있는 그 사람 창에도 한 줄 띄운다
notify() {
    local who=$1 key=$2 msg=$3 f
    # 이름은 프로세스 환경·컨테이너 이름표에서 오므로 누구나 정할 수 있다. 명단에 있는 이름에만 보낸다(파일 경로로 쓰이므로)
    if [ "$who" != 관리자 ]; then
        case "$who" in ''|*/*|.*) return 0 ;; esac
        is_member "$who" || return 0
    fi
    mkdir -p "$NOTE"; f="$NOTE/$who.txt"
    [ -f "$f" ] && grep -qF "	$key	" "$f" && return 0
    printf '%s\t%s\t%s\n' "$(date '+%F %H:%M')" "$key" "$msg" >> "$f"
    [ "$who" = 관리자 ] && return 0
    push_tty "$who" "$msg"
}
# 그 사람이 열어 둔 터미널 찾기: 셸 환경의 B200_USER
push_tty() {
    local who=$1 msg=$2 p t
    for p in /proc/[0-9]*; do
        [ "$(cat "$p/comm" 2>/dev/null)" = bash ] || continue
        { tr '\0' '\n' < "$p/environ"; } 2>/dev/null | grep -qxF "B200_USER=$who" || continue
        t=$(readlink "$p/fd/0" 2>/dev/null); case "$t" in /dev/pts/*) echo "$t" ;; esac
    done | sort -u | while read -r t; do
        timeout 2 bash -c 'printf "\r\n\e[33m[B200 알림]\e[0m %s\r\n" "$1" > "$2"' _ "$msg" "$t" 2>/dev/null
    done
}
# 접속할 때: 아직 안 본 알림을 보여 준다(최근 14일, 많아도 5줄)
cmd__notices() {
    local who=${1:-$ME} f seen total since
    [ -n "$who" ] || return 0
    case "$who" in */*|.*) return 0 ;; esac
    f="$NOTE/$who.txt"; [ -f "$f" ] || return 0
    local sf="$SEEN/$who"; is_root && sf="$ST/reports/.notice_seen"   # 관리자 것은 root 만 쓰는 곳에
    seen=$(cat "$sf" 2>/dev/null); [[ "$seen" =~ ^[0-9]+$ ]] || seen=0   # 숫자만 믿는다
    total=$(wc -l < "$f")
    [ "$total" -gt "$seen" ] || return 0
    since=$(date -d '14 days ago' +%F)
    echo "${c_y}알림${c_0}"
    tail -n +"$((seen + 1))" "$f" | awk -F'\t' -v s="$since" '$1>=s {print "  [" substr($1,6) "] " $3}' | tail -5
    { echo "$total" > "$sf"; } 2>/dev/null
}

# ------------------------------------------------------------------ 접속 인사
cmd__hello() {
    echo
    echo "${c_b}B200 서버${c_0}  팀원 모두가 공용 계정으로 써요. 이름을 고르면 GPU·컨테이너 옆에 이름이 보여요."
    cmd_who
}
cmd__names() {   # 고르기 쉽게 번호를 붙인다
    members | awk '{printf "  %2d %s", NR, $0; if (NR % 6 == 0) printf "\n"} END {if (NR % 6) printf "\n"}'
}

# ------------------------------------------------------------------ 정기 점검(root, 10분마다): 기록과 알림
cmd__check() {
    local now day week f use
    now=$(date '+%F %T'); day=$(date +%F); week=$(date +%G-W%V)
    mkdir -p "$ST/gpu_log" "$NOTE"
    f="$ST/gpu_log/$(date +%Y-%m).tsv"
    load_usage
    # 1. 기록: 시각 GPU 사람 어디 사용률 메모리
    local util; util=$("$NVSMI" --query-gpu=index,utilization.gpu,memory.used --format=csv,noheader,nounits 2>/dev/null)
    echo "$USAGE" | while read -r g who where; do
        [ -n "$g" ] || continue
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$now" "$g" "$who" "$where" \
            "$(echo "$util" | awk -F', ' -v g="$g" '$1==g {print $2}')" "$(echo "$util" | awk -F', ' -v g="$g" '$1==g {print $3}')"
    done >> "$f"
    # 2. 겹침: 한 GPU를 두 사람 이상이 쓴다 → 각자에게 하루 한 번
    for g in $(echo "$USAGE" | awk '{print $1}' | sort -un); do
        local us; us=$(users_of "$g" | grep -v '^?$')
        [ "$(echo "$us" | grep -c .)" -ge 2 ] || continue
        for u in $us; do
            notify "$u" "겹침-$g-$day" "GPU ${g}번을 $(echo "$us" | tr '\n' ' ' | sed 's/ $//; s/ /, /g') 님이 같이 쓰고 있어요. 메모리가 모자라면 둘 다 멈춰요. nvidia-smi 로 보고 서로 정해 주세요."
        done
    done
    # 2-1. 다른 팀 GPU: 우리 팀이 쓰고 있으면 그 사람과 관리자에게 하루 한 번
    for g in $(other_gpus); do
        echo "$USAGE" | awk -v g="$g" '$1==g {print $2, $3}' | sort -u | while read -r u where; do
            local wtxt=''; [ "$where" = - ] || wtxt="(컨테이너 $where)"
            notify "$u" "다른팀-$g-$day" "GPU ${g}번은 다른 팀 GPU예요$wtxt. 멈추고 우리 팀 GPU로 옮겨 주세요(nvidia-smi 의 배분 칸)."
            [ "$u" = '?' ] && u='이름 없는 작업' || u="$u 님"
            notify 관리자 "다른팀-$g-$u-$day" "${u}이 다른 팀 GPU ${g}번을 쓰고 있어요$wtxt."
        done
    done
    # 3. 놀고 있는 GPU: 정한 시간 내내 사용률 0% → 그 사람에게 하루 한 번
    local need=$(( IDLE_HOURS * 6 * 9 / 10 )) since; since=$(date -d "$IDLE_HOURS hours ago" '+%F %T')
    cat "$ST/gpu_log/$(date -d "$IDLE_HOURS hours ago" +%Y-%m).tsv" "$f" 2>/dev/null | sort -u |
        awk -F'\t' -v s="$since" -v need="$need" '$1>=s && $3!="?" {k=$2"\t"$3"\t"$4; n[k]++; if ($5+0>0) busy[k]=1}
            END {for (k in n) if (n[k]>=need && !busy[k]) print k}' |
        while IFS=$'\t' read -r g u where; do
            echo "$USAGE" | awk -v g="$g" -v u="$u" '$1==g && $2==u' | grep -q . || continue   # 지금도 잡고 있을 때만
            local how="다 썼으면 GPU를 놓아 주세요"
            [ "$where" != - ] && how="다 썼으면 docker stop $where 로 GPU를 놓아 주세요"
            notify "$u" "놀고있음-$g-$day" "GPU ${g}번을 ${IDLE_HOURS}시간째 잡고만 있어요(사용률 0%). $how."
        done
    # 4. 이름 없는 GPU 사용 → 관리자에게만
    echo "$USAGE" | awk '$2=="?" {print $1, $3}' | sort -u | while read -r g where; do
        is_other "$g" && continue   # 2-1 에서 알렸다
        [ "$where" = - ] && where='' || where="(컨테이너 $where)"
        notify 관리자 "이름없음-$g-$day" "GPU ${g}번을 이름 없는 작업이 쓰고 있어요$where. nvidia-smi 로 확인하세요."
    done
    # 5. 디스크 → 많이 쓰는 3명과 관리자에게 주 한 번
    use=$(df -P "$APP" 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')
    if [ "${use:-0}" -ge "$DISK_ALERT" ]; then
        notify 관리자 "디스크-$week" "디스크 /app 이 ${use}% 찼어요."
        du -s "$W"/*/ 2>/dev/null | sort -rn | head -3 | while read -r _ d; do
            local u; u=$(basename "$d"); is_member "$u" || continue
            notify "$u" "디스크-$week" "디스크가 ${use}% 찼어요. 내 작업 폴더($(du -sh "$d" | cut -f1))와 안 쓰는 도커 이미지를 정리해 주세요."
        done
    fi
    # 6. 이미지: 쓰는 날 기록, 오래 안 쓴 이미지는 들여온 사람에게 주 한 번
    if [ -n "$HAVE_DOCKER" ]; then
        echo "$CONTAINERS" | cut -f5 | grep . | sort -u | while read -r ref; do printf '%s\t%s\n' "$ref" "$day"; done |
            cat - "$USED" 2>/dev/null | sort -t$'\t' -k1,1 -k2,2r | sort -t$'\t' -u -k1,1 > "$USED.new" &&
            mv "$USED.new" "$USED"
        local old; old=$(date -d "$IMAGE_NOTICE_DAYS days ago" +%F)
        image_table | while IFS=$'\t' read -r ref who last _; do
            [ "$last" != - ] && [[ "$last" < "$old" ]] || continue
            if is_member "$who" && [ -n "$(members)" ]; then
                notify "$who" "이미지-$ref-$week" "도커 이미지 $ref 를 ${IMAGE_NOTICE_DAYS}일 넘게 안 썼어요(마지막 $last). 필요 없으면 docker rmi $ref"
            else
                notify 관리자 "이미지-$ref-$week" "주인을 모르는 이미지 $ref, 마지막 사용 $last."
            fi
        done
    fi
    # 7. GPU 오류 → 관리자에게 하루 한 번
    if "$NVSMI" -q -d ECC 2>/dev/null | grep -qiE 'uncorr.*: [1-9]'; then notify 관리자 "ECC-$day" "GPU 메모리 오류(ECC)가 있어요: nvidia-smi -q -d ECC"; fi
    if journalctl -k --since '10 min ago' 2>/dev/null | grep -qi 'NVRM: Xid'; then notify 관리자 "Xid-$day" "GPU 오류(Xid)가 있어요: journalctl -k | grep Xid"; fi
    true
}

# 이미지마다 "이미지<TAB>들여온 사람<TAB>마지막 사용일<TAB>크기" (들여온 날과 컨테이너로 쓴 날 중 늦은 날)
image_table() {
    [ -n "$HAVE_DOCKER" ] || return 0
    local led=() f
    for f in "$ST/images/loaded.tsv" "$USED"; do [ -f "$f" ] && [ ! -L "$f" ] && led+=("$f"); done   # loaded.tsv 는 docker 래퍼(공용 계정)가 쓴다. root 가 만들지 않는다
    "${DOCKER[@]}" images --format '{{.Repository}}:{{.Tag}}{{"\t"}}{{.CreatedAt}}{{"\t"}}{{.Size}}' 2>/dev/null | grep -v '^<none>' |
    while IFS=$'\t' read -r ref created size; do
        awk -F'\t' -v r="$ref" -v c="${created:0:10}" -v sz="$size" '
            FILENAME ~ /loaded/ && $3==r {who=$2; d=substr($1,1,10); if (d>last) last=d}
            FILENAME ~ /used/ && $1==r {if ($2>last) last=$2}
            END {if (!last) last=c; printf "%s\t%s\t%s\t%s\n", r, (who?who:"모름"), (last?last:"-"), sz}' \
            "${led[@]}" /dev/null
    done
}

# ------------------------------------------------------------------ 주간 보고서(root, 월요일 아침)
cmd__report() {
    local since; since=$(date -d '7 days ago' '+%F %T')
    echo "B200 주간 보고서  $(date -d '7 days ago' +%F) ~ $(date +%F)"
    echo
    echo "== 사람별 GPU 시간 (10분 기록 ÷ 6)"
    cat "$ST/gpu_log/$(date -d '7 days ago' +%Y-%m).tsv" "$ST/gpu_log/$(date +%Y-%m).tsv" 2>/dev/null | sort -u |
        awk -F'\t' -v s="$since" '$1>=s {k=$1"\t"$2"\t"$3; if (!(k in seen)) {seen[k]=1; n[$3]++; if ($5+0==0) idle[$3]++}}
            END {for (u in n) printf "%s\t%.1f\t%.1f\n", u, n[u]/6, idle[u]/6}' | sort -t$'\t' -k2,2 -rn |
        while IFS=$'\t' read -r u h i; do echo "  $(pad "$u" 12) $h 시간 (그중 사용률 0% $i 시간)"; done
    echo
    echo "== 디스크"
    df -h "$APP" | awk 'NR==2 {print "  /app "$3" / "$2" ("$5")"}'
    du -sh "$W"/*/ 2>/dev/null | sort -rh | head -10 | sed "s#$W/##; s#/\$##; s/^/  /"
    if [ -n "$HAVE_DOCKER" ]; then
        echo
        echo "== 도커 이미지 (이미지, 들여온 사람, 마지막 사용, 크기)"
        image_table | sort -t$'\t' -k3,3 | awk -F'\t' '{printf "  %-50s %-10s %s  %s\n", $1, $2, $3, $4}'
    fi
    echo
    echo "== 지난 7일 알림"
    for f in "$NOTE"/*.txt; do
        [ -f "$f" ] || continue
        awk -F'\t' -v s="${since:0:16}" -v who="$(basename "$f" .txt)" '$1>=s {print "  " $1 " " who ": " $3}' "$f"
    done | sort
}

# ------------------------------------------------------------------ 관리자 점검
cmd_doctor() {
    echo "== GPU"; "$NVSMI" -L 2>&1 | head -8
    echo "== 공용 Python 환경"
    CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0} "$S/venv/bin/python" -c 'import torch; n=torch.cuda.device_count(); [ (torch.randn(64,64,device=f"cuda:{i}")@torch.randn(64,64,device=f"cuda:{i}")).sum().item() for i in range(n)]; print("PyTorch", torch.__version__, "GPU", n, "장 계산 확인")' 2>&1 | tail -1
    echo "== 도커"
    [ -n "$HAVE_DOCKER" ] || { echo '  도커 데몬에 연결하지 못했어요(systemctl status b200-docker)'; return; }
    "${DOCKER[@]}" info --format '  Docker {{.ServerVersion}}, {{.DockerRootDir}}, {{.SecurityOptions}}' 2>&1 | tail -1
    [ $# -ge 1 ] || { echo '  GPU 컨테이너까지 보려면: b200 doctor <PyTorch 이미지>'; return; }
    "${DOCKER[@]}" run --rm --gpus '"device=0"' --entrypoint '' "$1" sh -c \
        'P=$(command -v python || command -v python3); $P -c "import torch; x=torch.randn(64,64,device=\"cuda\"); print(\"  PyTorch\", torch.__version__, \"CUDA\", torch.version.cuda, \"GPU 계산\", float((x@x).sum()) == float((x@x).sum()))"' 2>&1 | tail -3
    echo "  (컨테이너에 GPU 1장만 보이는지: 위 명령에 nvidia-smi -L 을 넣어 확인)"
}

case "${1:-}" in
    ''|who)       cmd_who ;;
    doctor)       shift; cmd_doctor "$@" ;;
    _hello)       cmd__hello ;;
    _names)       cmd__names ;;
    _resolve)     resolve_name "${2:-}" ;;
    _notices)     cmd__notices "${2:-}" ;;
    _gpu-warn)    cmd__gpu_warn "${2:-}" ;;
    _check)       cmd__check ;;
    _report)      cmd__report ;;
    *)            echo "쓰는 법: b200 [who] | doctor [이미지]   (나머지는 접속 설정·docker·정기 점검이 부른다)"; exit 1 ;;
esac

#!/usr/bin/env bash
# B200 서버 팀원 명령. 관리자가 /app/shared/bin/b200 에 깐다(admin_setup.sh).
# 공용 계정 하나로 여럿이 쓰므로, 접속할 때 입력한 이름(B200_USER)으로 사람을 구분한다.
set -uo pipefail
APP=${B200_APP:-/app}   # 시험할 때만 바꾼다
S=$APP/shared
W=$APP/workspace
ST=$APP/state
ACC=${B200_ACCOUNT:-shareduser}
TEAM=$S/team.txt
ALLOC=$S/gpu_alloc.txt
ME=${B200_USER:-}
# 관리자가 정하는 숫자(/app/shared/b200.conf 가 있으면 그 값)
MAX_GPUS=4; BORROW_MINUTES=30; UNKNOWN_KILL_MINUTES=60; IMAGE_NOTICE_DAYS=30; IMAGE_DELETE_DAYS=45; PORT_BASE=8000
[ -r "$S/b200.conf" ] && . "$S/b200.conf"
c_g=$'\e[32m'; c_y=$'\e[33m'; c_r=$'\e[31m'; c_c=$'\e[36m'; c_b=$'\e[1m'; c_0=$'\e[0m'
ok()   { echo "${c_g}[정상]${c_0} $*"; }
# 안내는 표준 오류로 낸다($( ) 로 값을 받을 때 섞이지 않고 화면에 보이게)
warn() { echo "${c_y}[주의]${c_0} $*" >&2; }
die()  { echo "${c_r}[안 됨]${c_0} $1" >&2; [ -n "${2:-}" ] && echo "  → $2" >&2; exit 1; }
is_root() { [ "$(id -u)" = 0 ]; }

# ------------------------------------------------------------------ 명단·배분
members()   { [ -f "$TEAM" ] && grep -vE '^\s*(#|$)' "$TEAM" | awk '{print $1}'; }
group_of()  { [ -f "$TEAM" ] && awk -v n="$1" '!/^\s*#/ && $1==n {print $2; exit}' "$TEAM"; }
alloc_of()  { [ -f "$ALLOC" ] && awk -v g="$1" '!/^\s*#/ && $1==g {print $2; exit}' "$ALLOC"; }
is_member() {
    [ -n "$1" ] || return 1
    case "$1" in *-*|*/*|*' '*) return 1 ;; esac
    [ -n "$(members)" ] || return 0          # 명단이 비어 있으면(처음 설정할 때만) 아무 이름이나 받는다
    members | grep -qxF "$1"
}
need_me() {
    if is_root; then ME=${ME:-관리자}; return 0; fi   # 관리자는 규칙 집행(남의 작업 멈추기 등)을 위해 통과
    [ -n "$ME" ] || die '이름이 정해지지 않았어요.' '접속을 끊고 다시 접속해 이름을 입력하세요.'
    is_member "$ME" || die "등록된 이름이 아니에요: $ME" '접속을 끊고 다시 접속해 이름을 입력하세요.'
}
no_root() { is_root && die '관리자(root)로는 작업을 실행하지 않아요.' "공용 계정($ACC)으로 접속해 실행하세요."; return 0; }

# ------------------------------------------------------------------ 도커, tmux
if is_root && id "$ACC" >/dev/null 2>&1; then
    # root(정기 점검·규칙 집행)는 공용 계정의 도커와 tmux 에 공용 계정으로 붙는다
    DOCKER=(runuser -u "$ACC" -- env DOCKER_HOST="unix:///run/user/$(id -u "$ACC")/docker.sock" PATH="/opt/b200/docker/current:/usr/bin:/bin" docker)
    TMUXB=(runuser -u "$ACC" -- env LC_ALL=C.UTF-8 tmux -L b200)
else
    DOCKER=(docker)
    # b200 작업은 전용 tmux(-L b200)에서 돈다. 언어 설정이 UTF-8 이 아니면 tmux 가 한글 세션 이름을 _ 로 바꾸므로 고정한다
    TMUXB=(env -u TMUX LC_ALL=C.UTF-8 tmux -L b200)
fi
docker_cmd() { "${DOCKER[@]}" "$@"; }
have_docker() { command -v docker >/dev/null 2>&1 || [ -x /opt/b200/docker/current/docker ]; }

# ------------------------------------------------------------------ GPU 프로세스 → 사람
# 사람은 ① 프로세스 환경의 B200_USER(접속할 때 입력한 이름이 따라간다) ② 작업 폴더 이름 순서로 찾는다
owner_of_pid() {
    local pid=$1 u cwd
    u=$( { tr '\0' '\n' < "/proc/$pid/environ"; } 2>/dev/null | sed -n 's/^B200_USER=//p' | head -1)
    if [ -z "$u" ]; then
        cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null)
        case "$cwd" in "$W"/*) u=${cwd#"$W"/}; u=${u%%/*} ;; esac
    fi
    echo "${u:-?}"
}
# 한 줄에 "gpu pid 메모리MiB 사람" 을 낸다
gpu_procs() {
    local map
    map=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null)
    nvidia-smi --query-compute-apps=gpu_uuid,pid,used_memory --format=csv,noheader,nounits 2>/dev/null |
        while IFS=', ' read -r uuid pid mem; do
            [ -n "$pid" ] || continue
            idx=$(echo "$map" | awk -F', ' -v u="$uuid" '$2==u {print $1}')
            echo "$idx $pid $mem $(owner_of_pid "$pid")"
        done
}
gpu_count() { nvidia-smi -L 2>/dev/null | wc -l; }

# ------------------------------------------------------------------ b200 작업(tmux 세션)
# 한 줄에 "세션 사람 GPU목록 종류 상태 시작" 을 낸다. 종류: run|shell|docker, 상태: 실행중|끝남|셸
sessions() {
    "${TMUXB[@]}" ls -F '#S|#{t:session_created}' 2>/dev/null | while IFS='|' read -r s t; do
        local gpus kind state env
        env=$("${TMUXB[@]}" show-environment -t "=$s" 2>/dev/null)
        gpus=$(echo "$env" | sed -n 's/^B200_GPUS=//p'); kind=$(echo "$env" | sed -n 's/^B200_KIND=//p'); kind=${kind:-run}
        if [ "$kind" = shell ]; then state=셸
        elif echo "$env" | grep -qx 'B200_STATE=done'; then state=끝남   # 작업이 끝나면 스스로 표시한다(창은 결과를 보게 남는다)
        else state=실행중; fi
        echo "$s ${s%%-*} ${gpus:--} $kind $state $t"
    done
}
# 다른 사람이 쓰거나(프로세스) 잡아 둔(살아 있는 b200 작업) GPU 번호들
taken_by_others() {
    { gpu_procs | awk -v me="$ME" '$4!=me {print $1}'
      sessions | awk -v me="$ME" '$2!=me && $5!="끝남" {print $3}' | tr ',' '\n' | grep -v '^-$'
    } | grep . | sort -un
}
# 내가 지금 쓰거나 잡아 둔 GPU 번호들
mine_now() {
    { gpu_procs | awk -v me="$ME" '$4==me {print $1}'
      sessions | awk -v me="$ME" '$2==me && $5!="끝남" {print $3}' | tr ',' '\n' | grep -v '^-$'
    } | grep . | sort -un
}
claims() { [ -f "$ST/claims.tsv" ] && awk -F'\t' -v now="$(date +%s)" '$4>now' "$ST/claims.tsv"; }   # gpu 요청자 요청시각 마감시각
claimed() { claims | awk -F'\t' -v g="$1" '$1==g' | head -1; }

# ------------------------------------------------------------------ GPU 고르기 검사
# 빈 GPU 를 내 그룹 → 공용 순서로 $1 장 고른다. 다른 그룹 GPU 는 auto 로 고르지 않는다(빌리려면 번호를 정한다)
pick_gpus() {
    local want=$1 mygrp taken picked=() i grp
    # 남이 쓰거나 잡아 둔 GPU 와 내가 이미 쓰는 GPU 는 빼고 고른다
    mygrp=$(group_of "$ME"); taken=" $( { taken_by_others; mine_now; } | tr '\n' ' ') "
    for pass in mine shared; do
        for i in $(seq 0 $(( $(gpu_count) - 1 ))); do
            [ ${#picked[@]} -lt "$want" ] || break
            case "$taken" in *" $i "*) continue ;; esac
            case " ${picked[*]} " in *" $i "*) continue ;; esac
            [ -z "$(claimed "$i")" ] || continue
            grp=$(alloc_of "$i")
            case $pass in
                mine)   [ -n "$mygrp" ] && [ "$grp" = "$mygrp" ] || continue ;;
                shared) [ "$grp" = 공용 ] || [ -z "$grp" ] || continue ;;
            esac
            picked+=("$i")
        done
    done
    [ ${#picked[@]} -eq "$want" ] || die "내 그룹과 공용 GPU 중 빈 것이 $want 장이 안 돼요(지금 ${#picked[@]}장)." \
        'b200 으로 현황을 보고, 다른 그룹 GPU를 빌리려면 번호를 직접 적으세요(예: b200 run 4 ...).'
    local IFS=,; echo "${picked[*]}"
}

check_gpus() {   # $1 "1,2" 나 "auto", "auto:2" → 통과하면 정리된 목록, 안 되면 멈춤
    local list=$1 g n mygrp grp taken mine cnt cl
    if [[ "$list" =~ ^auto(:([1-8]))?$ ]]; then
        list=$(pick_gpus "${BASH_REMATCH[2]:-1}") || exit 1
        echo "${c_c}[선택]${c_0} 빈 GPU $list" >&2
    fi
    [[ "$list" =~ ^[0-7](,[0-7])*$ ]] || die "GPU 번호가 이상해요: $list" '예: auto(빈 GPU 1장), auto:2(2장), 1, 1,2'
    n=$(gpu_count); mygrp=$(group_of "$ME")
    taken=" $(taken_by_others | tr '\n' ' ') "
    for g in ${list//,/ }; do
        [ "$g" -lt "$n" ] || die "GPU $g 는 없어요(0~$((n - 1)))."
        case "$taken" in *" $g "*) die "GPU $g 는 지금 다른 사람이 쓰거나 잡아 두었어요." 'b200 으로 현황을 보고 auto 를 쓰세요.' ;; esac
        grp=$(alloc_of "$g")
        if [ -n "$grp" ] && [ "$grp" != 공용 ] && [ -n "$mygrp" ] && [ "$grp" != "$mygrp" ]; then
            cl=$(claimed "$g")
            [ -z "$cl" ] || die "GPU $g 는 '$grp' 그룹이 돌려 달라고 요청한 GPU예요."
            warn "GPU $g 는 '$grp' 그룹 GPU를 빌리는 거예요. 그 그룹이 b200 claim 으로 요청하면 ${BORROW_MINUTES}분 뒤 자동으로 멈춰요."
        fi
    done
    mine=$(mine_now | grep -c .); cnt=$(echo "${list//,/ }" | wc -w)
    [ $((mine + cnt)) -le "$MAX_GPUS" ] || die "한 사람이 동시에 쓸 수 있는 GPU는 ${MAX_GPUS}장이에요(지금 ${mine}장 사용 중)." 'b200 ps 로 내 작업을 확인하세요.'
    echo "$list"
}

new_session_name() { echo "$ME-$(date +%m%d-%H%M%S)"; }

# 내 셸의 환경(venv, PYTHONPATH 등)을 그대로 작업에 넘긴다
save_env() {
    export -p | grep -vE '^declare -x (TMUX|TMUX_PANE|SHLVL|PWD|OLDPWD|_|B200_PROFILE_DONE|CUDA_VISIBLE_DEVICES)=' > "$1"
}

# 세션을 만든다: $1 세션 $2 폴더 $3 GPU $4 종류 $5 실행할 bash 문장
start_session() {
    local sess=$1 dir=$2 gpus=$3 kind=$4 inner=$5 kv
    "${TMUXB[@]}" new-session -d -s "$sess" -c "$dir" "bash -c $(printf %q "$inner")" || die 'tmux 세션을 만들지 못했어요.'
    # 이 세션에서 새로 여는 창도 내 이름·내 GPU 로. b200 ps·현황이 이 값으로 GPU 예약을 안다
    for kv in "B200_USER=$ME" "B200_GPUS=$gpus" "B200_KIND=$kind" "CUDA_VISIBLE_DEVICES=$gpus"; do
        "${TMUXB[@]}" set-environment -t "=$sess" "${kv%%=*}" "${kv#*=}"
    done
}

# ------------------------------------------------------------------ 실행
cmd_run() {
    no_root; need_me
    [ $# -ge 2 ] || die '쓰는 법: b200 run <GPU> <명령>' '예: b200 run auto python train.py,  b200 run auto:2 "cd src && python train.py"'
    local gpus sess log dir envf cmdq
    gpus=$(check_gpus "$1") || exit 1; shift
    sess=$(new_session_name); dir=$PWD
    case "$dir" in "$W/$ME"|"$W/$ME"/*) ;; *) warn "지금 폴더($dir)가 내 작업 폴더($W/$ME) 밖이에요." ;; esac
    mkdir -p "$W/$ME/logs"; log="$W/$ME/logs/$sess.log"; envf="$W/$ME/logs/.$sess.env"
    save_env "$envf"
    # 따옴표 하나로 준 명령은 셸 문장 그대로("cd src && python train.py"), 여러 낱말이면 그대로 실행
    if [ $# -eq 1 ]; then cmdq=$1; else printf -v cmdq '%q ' "$@"; fi
    start_session "$sess" "$dir" "$gpus" run "source $(printf %q "$envf")
export B200_USER=$(printf %q "$ME") B200_GPUS=$gpus CUDA_VISIBLE_DEVICES=$gpus
cd $(printf %q "$dir")
echo \"[b200] \$(date '+%F %T') 시작: GPU $gpus\" | tee -a $(printf %q "$log")
( $cmdq ) 2>&1 | tee -a $(printf %q "$log")
echo \"[b200] \$(date '+%F %T') 끝 (종료 코드 \${PIPESTATUS[0]}). 이 창은 b200 stop 으로 닫아요\" | tee -a $(printf %q "$log")
tmux set-environment B200_STATE done 2>/dev/null
exec bash"
    ok "GPU $gpus 에서 시작했어요. 접속이 끊겨도 계속 돌아요."
    echo "  보기: b200 attach   멈추기: b200 stop   기록: $log"
}

cmd_shell() {
    no_root; need_me
    local gpus sess
    gpus=$(check_gpus "${1:-auto}") || exit 1
    sess=$(new_session_name)
    start_session "$sess" "$PWD" "$gpus" shell "export B200_USER=$(printf %q "$ME") B200_GPUS=$gpus CUDA_VISIBLE_DEVICES=$gpus; exec bash"
    ok "GPU $gpus 를 배정한 셸을 열어요. 끊겨도 남아 있고, 다 쓰면 b200 stop 으로 GPU를 돌려줘요."
    echo "  나오기(셸은 계속): Ctrl+b 누른 뒤 d"
    [ -t 1 ] && exec "${TMUXB[@]}" attach -t "=$sess"
}

cmd_docker() {
    no_root; need_me
    have_docker || die '이 서버에는 아직 도커가 설치되지 않았어요.' '관리자에게 문의하세요.'
    [ $# -ge 2 ] || die '쓰는 법: b200 docker <GPU> <이미지> [명령]' '예: b200 docker auto nvcr.io/nvidia/pytorch:25.10-py3 python train.py'
    local gpus img sess log cmdq
    gpus=$(check_gpus "$1") || exit 1; img=$2; shift 2
    docker_cmd image inspect "$img" >/dev/null 2>&1 || die "이미지가 없어요: $img" 'b200 images 로 목록을 보거나 b200 image-load 로 들여오세요.'
    sess=$(new_session_name)
    mkdir -p "$W/$ME/logs"; log="$W/$ME/logs/$sess.log"
    # 내 작업 폴더는 /workspace(쓰기), 공용 폴더는 /app/shared(읽기 전용)로 연결한다
    local args=(run --rm --name "$sess" --gpus "\"device=$gpus\"" --label "b200.user=$ME"
        -e "B200_USER=$ME" --shm-size 32g --ulimit memlock=-1 --ulimit stack=67108864
        -v "$W/$ME:/workspace" -v "$S:$S:ro" -w /workspace -it "$img")
    printf '%s\t%s\t%s\n' "$(date '+%F %T')" "$ME" "$img" >> "$ST/images/used.tsv"
    if [ $# -eq 0 ]; then
        printf -v cmdq '%q ' "${DOCKER[@]}" "${args[@]}" bash
        start_session "$sess" "$W/$ME" "$gpus" shell "$cmdq; echo '[b200] 컨테이너 셸이 끝났어요. b200 stop 으로 닫아요'; exec bash"
        echo "  컨테이너 셸을 열어요(끊겨도 남아 있어요). 내 작업 폴더는 /workspace. 나오기: Ctrl+b 누른 뒤 d"
        [ -t 1 ] && exec "${TMUXB[@]}" attach -t "=$sess"
        return
    fi
    printf -v cmdq '%q ' "${DOCKER[@]}" "${args[@]}" "$@"
    start_session "$sess" "$W/$ME" "$gpus" docker "$cmdq 2>&1 | tee -a $(printf %q "$log")
echo \"[b200] \$(date '+%F %T') 끝 (종료 코드 \${PIPESTATUS[0]}). 이 창은 b200 stop 으로 닫아요\" | tee -a $(printf %q "$log")
tmux set-environment B200_STATE done 2>/dev/null
exec bash"
    ok "컨테이너를 GPU $gpus 에서 시작했어요. 접속이 끊겨도 계속 돌아요."
    echo "  보기: b200 attach   멈추기: b200 stop   기록: $log"
}

# 번호나 세션 이름으로 내 작업 하나를 고른다. 비우면 내 작업이 하나일 때 그것
pick_session() {
    local arg=${1:-} list n
    list=$(sessions | { if is_root; then cat; else awk -v me="$ME" '$2==me'; fi; })
    n=$(echo "$list" | grep -c .)
    if [ -z "$arg" ]; then
        [ "$n" -gt 0 ] || die '내 작업이 없어요.'
        [ "$n" -eq 1 ] || { cmd_ps >&2; die '작업이 여러 개예요. 번호를 붙여 주세요(예: b200 stop 2).'; }
        echo "$list" | awk '{print $1}'; return
    fi
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
        echo "$list" | sed -n "${arg}p" | awk '{print $1}' | grep . || die "작업 번호 $arg 가 없어요." 'b200 ps 로 번호를 확인하세요.'
        return
    fi
    echo "$list" | awk -v s="$arg" '$1==s {print $1}' | grep . || die "내 작업이 아니에요: $arg" '다른 사람 작업은 그 사람에게 요청하세요.'
}

cmd_stop() {
    need_me
    local sess; sess=$(pick_session "${1:-}") || exit 1
    have_docker && docker_cmd stop "$sess" >/dev/null 2>&1
    "${TMUXB[@]}" kill-session -t "=$sess" 2>/dev/null && ok "$sess 멈춤(GPU 반납)" || die "작업이 없어요: $sess"
}

cmd_attach() {
    need_me
    local sess; sess=$(pick_session "${1:-}") || exit 1
    echo "  나오기(작업은 계속): Ctrl+b 누른 뒤 d"
    exec "${TMUXB[@]}" attach -t "=$sess"
}

cmd_ps() {
    local who=$ME; is_root && who=''
    echo "${who:-모두}의 작업 (보기: b200 attach 번호,  멈추기: b200 stop 번호)"
    printf '  %-4s %-24s %-8s %-7s %s\n' 번호 세션 GPU 상태 시작
    sessions | { if [ -n "$who" ]; then awk -v me="$who" '$2==me'; else cat; fi; } | nl -w1 -s' ' |
        while read -r i s _ g _ st t; do printf '  %-4s %-24s %-8s %-7s %s\n' "$i" "$s" "$g" "$st" "$t"; done
}

# ------------------------------------------------------------------ 반납 요청
cmd_claim() {
    no_root; need_me
    [ $# -eq 1 ] && [[ "$1" =~ ^[0-7]$ ]] || die '쓰는 법: b200 claim <GPU 번호>' '우리 그룹 GPU를 다른 그룹이 빌려 쓰고 있을 때 돌려 달라고 요청해요.'
    local g=$1 grp mygrp users now
    grp=$(alloc_of "$g"); mygrp=$(group_of "$ME")
    [ -n "$mygrp" ] && [ "$grp" = "$mygrp" ] || die "GPU $g 는 우리 그룹('${mygrp:-없음}') GPU가 아니에요(배분: ${grp:-없음})."
    users=$({ gpu_procs | awk -v g="$g" '$1==g {print $4}'
              sessions | awk -v g="$g" '$5!="끝남" {n=split($3,a,","); for(i=1;i<=n;i++) if(a[i]==g) print $2}'; } |
            sort -u | while read -r u; do [ "$(group_of "$u")" != "$mygrp" ] && echo "$u"; done | tr '\n' ' ')
    [ -n "$users" ] || die "GPU $g 는 지금 다른 그룹이 쓰고 있지 않아요."
    [ -z "$(claimed "$g")" ] || die "GPU $g 는 이미 반납을 요청했어요."
    now=$(date +%s)
    printf '%s\t%s\t%s\t%s\n' "$g" "$ME" "$now" "$((now + BORROW_MINUTES * 60))" >> "$ST/claims.tsv"
    ok "GPU $g 반납을 요청했어요. ${users}의 작업은 $(date -d "@$((now + BORROW_MINUTES * 60))" +%H:%M)에 자동으로 멈춰요."
}

# ------------------------------------------------------------------ 현황
cmd_status() {
    local mygrp procs ses cls; mygrp=$(group_of "$ME")
    echo "${c_b}B200 현황${c_0}  $(date '+%m-%d %H:%M')    나: ${ME:-이름 없음}${mygrp:+ ($mygrp)}"
    if ! nvidia-smi -L >/dev/null 2>&1; then
        warn 'GPU 정보를 읽지 못했어요(nvidia-smi). 관리자에게 알려 주세요.'
    else
        procs=$(gpu_procs); ses=$(sessions); cls=$(claims)
        printf '%-4s %-14s %-14s %-11s %-6s %s\n' GPU 배분 '쓰는 사람' '메모리(GB)' 사용률 '실행 시간 / 명령'
        nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits |
        while IFS=', ' read -r i mu mt ut; do
            grp=$(alloc_of "$i"); grp=${grp:--}
            who=$( { echo "$procs" | awk -v g="$i" '$1==g {print $4}'
                     echo "$ses" | awk -v g="$i" '$5!="끝남" {n=split($3,a,","); for(k=1;k<=n;k++) if(a[k]==g) print $2}'; } |
                   grep . | sort -u | tr '\n' ',' | sed 's/,$//')
            pid=$(echo "$procs" | awk -v g="$i" '$1==g {print $2; exit}')
            detail=''
            [ -n "$pid" ] && detail="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ') $(ps -o args= -p "$pid" 2>/dev/null | cut -c1-40)"
            [ -z "$pid" ] && [ -n "$who" ] && detail='(잡아 둠, 아직 GPU 안 씀)'
            mark=''
            if [ -n "$who" ]; then
                case ",$who," in *',?,'*) mark="${c_r}" ;; esac
                if [ "$grp" != 공용 ] && [ "$grp" != - ]; then
                    for w in ${who//,/ }; do [ "$w" != '?' ] && [ "$(group_of "$w")" != "$grp" ] && mark="${c_y}"; done
                fi
            fi
            cl=$(echo "$cls" | awk -F'\t' -v g="$i" '$1==g {print $4; exit}')
            [ -n "$cl" ] && detail="${c_y}반납 요청: $(date -d "@$cl" +%H:%M)에 자동 종료${c_0} $detail"
            printf '%-4s %-14s %s%-14s%s %-11s %-6s %s\n' "$i" "$grp" "$mark" "${who:-비어 있음}" "$c_0" \
                "$((mu / 1024))/$((mt / 1024))" "$ut%" "$detail"
        done
        echo "  ${c_y}노랑${c_0}=다른 그룹 GPU를 빌려 씀  ${c_r}빨강${c_0}=누군지 모름(${UNKNOWN_KILL_MINUTES}분 뒤 자동 종료)"
    fi
    local du; du=$(df -P "$APP" 2>/dev/null | awk 'NR==2 {printf "%d/%d GB (%s)", $3/1048576, $2/1048576, $5}')
    echo "디스크 /app: $du$( [ -n "$ME" ] && [ -d "$W/$ME" ] && echo "   내 작업 폴더: $(du -sh "$W/$ME" 2>/dev/null | cut -f1)")"
    local rep; rep=$(ls -1 "$ST/reports"/*.txt 2>/dev/null | tail -1)
    if [ -n "$rep" ] && grep -q '^\[알림\]' "$rep"; then
        echo "${c_y}관리자 알림${c_0} ($(basename "$rep" .txt))"; grep '^\[알림\]' "$rep" | sed 's/^\[알림\] /  - /' | head -5
    fi
    echo "명령: b200 help   규칙: b200 rules"
}

# ------------------------------------------------------------------ 이미지
cmd_image_load() {
    need_me
    have_docker || die '이 서버에는 아직 도커가 설치되지 않았어요.'
    local files=() f a need free out ref loaded=()
    [ $# -ge 1 ] || set -- "$APP/inbox/images/$ME"
    for a in "$@"; do
        if [ -d "$a" ]; then while IFS= read -r f; do files+=("$f"); done < <(find "$a" -maxdepth 1 -type f \( -name '*.tar' -o -name '*.tar.gz' -o -name '*.tgz' -o -name '*.tar.zst' \) | sort)
        else files+=("$a"); fi
    done
    [ ${#files[@]} -gt 0 ] || die "들여올 파일(.tar, .tar.gz, .tar.zst)이 없어요: $*" "파일을 $APP/inbox/images/$ME 에 올렸는지 확인하세요."
    need=$(du -cm "${files[@]}" | tail -1 | cut -f1)
    free=$(df -Pm "$APP" | awk 'NR==2 {print $4}')
    [ "$free" -gt $((need * 3)) ] || die "남은 공간이 부족해요(남은 $((free / 1024)) GB, 필요 약 $((need * 3 / 1024)) GB)." 'b200 images 로 안 쓰는 이미지를 지우세요.'
    for f in "${files[@]}"; do
        echo "== $(basename "$f") ($(du -h "$f" | cut -f1))"
        if [ -f "$f.sha256" ]; then
            (cd "$(dirname "$f")" && sha256sum -c --quiet "$(basename "$f").sha256") || { warn "체크섬이 달라요. 다시 올려 주세요: $f"; continue; }
            ok '체크섬 일치'
        fi
        out=$(docker_cmd load -i "$f" 2>&1) || { warn "들여오지 못했어요: $(echo "$out" | tail -2)"; continue; }
        while read -r ref; do
            [ -n "$ref" ] || continue
            echo "  들여옴: $ref"
            printf '%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$ME" "$ref" "$(basename "$f")" >> "$ST/images/loaded.tsv"
            check_image "$ref"
        done < <(echo "$out" | sed -n 's/^Loaded image\( ID\)\?: //p')
        loaded+=("$f")
    done
    if [ ${#loaded[@]} -gt 0 ] && [ -t 0 ]; then
        read -r -p "  올린 파일 ${#loaded[@]}개를 지울까요(공간 확보)? [Y/n] " a
        [[ "$a" =~ ^[nN] ]] || { for f in "${loaded[@]}"; do rm -f "$f" "$f.sha256"; done; ok '올린 파일을 지웠어요.'; }
    fi
}

# 이미지 안 PyTorch 가 B200 에서 실제로 계산되는지 본다(PyTorch 가 없으면 건너뛴다)
check_image() {
    local ref=$1 out g
    g=$(ME=${ME:-_check} pick_gpus 1 2>/dev/null) || g=0
    out=$(timeout 300 "${DOCKER[@]}" run --rm --gpus "\"device=$g\"" --entrypoint '' "$ref" sh -c \
        'command -v python >/dev/null || command -v python3 >/dev/null || exit 3
         P=$(command -v python || command -v python3)
         $P -c "import torch" 2>/dev/null || exit 4
         $P -c "import torch; x=torch.randn(64,64,device=\"cuda\"); print(torch.__version__, torch.version.cuda, float((x@x).sum()))"' 2>&1)
    case $? in
        0) ok "B200 호환 검사 통과: PyTorch $(echo "$out" | tail -1 | awk '{print $1", CUDA "$2}')" ;;
        3|4) echo "  (PyTorch 가 없는 이미지라 GPU 검사는 건너뜀)" ;;
        *) if echo "$out" | grep -q 'no kernel image'; then
               warn 'B200 에서 계산이 안 돼요(no kernel image). CUDA 12.8 이상으로 빌드한 PyTorch 2.7 이상 이미지가 필요해요.'
           elif echo "$out" | grep -q 'executable file not found'; then
               echo "  (셸이 없는 이미지라 GPU 검사는 건너뜀)"
           else warn "GPU 검사 실패: $(echo "$out" | grep -m1 -iE 'error|failed' || echo "$out" | tail -1)"; fi ;;
    esac
}

# 이미지마다 "이미지<TAB>들여온사람<TAB>마지막사용일" (들여온 날과 b200 docker 로 쓴 날 중 늦은 날)
image_table() {
    local led=() f
    for f in "$ST/images/loaded.tsv" "$ST/images/used.tsv"; do [ -f "$f" ] && led+=("$f"); done
    docker_cmd images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -v '<none>' | sort -u | while read -r ref; do
        awk -F'\t' -v r="$ref" '
            FILENAME ~ /loaded/ && $3==r {who=$2; d=substr($1,1,10); if (d>last) last=d}
            FILENAME ~ /used/   && $3==r {d=substr($1,1,10); if (d>last) last=d}
            END {printf "%s\t%s\t%s\n", r, (who?who:"주인 없음"), (last?last:"-")}' "${led[@]}" /dev/null
    done
}

cmd_images() {
    have_docker || die '이 서버에는 아직 도커가 설치되지 않았어요.'
    printf '%-50s %-10s %-11s %-9s %s\n' 이미지 '들여온 사람' '마지막 사용' 크기 삭제예정
    image_table | while IFS=$'\t' read -r ref who last; do
        size=$(docker_cmd images --format '{{.Size}}' "$ref" 2>/dev/null | head -1)
        due='-'; [ "$last" != - ] && due=$(date -d "$last + $IMAGE_DELETE_DAYS days" +%F)
        printf '%-50s %-10s %-11s %-9s %s\n' "${ref:0:50}" "$who" "$last" "$size" "$due"
    done
    echo "지우기: b200 rmi <이미지>   (마지막 사용 후 ${IMAGE_NOTICE_DAYS}일이면 알림, ${IMAGE_DELETE_DAYS}일이면 관리자가 지워요)"
}

cmd_rmi() {
    need_me
    [ $# -eq 1 ] || die '쓰는 법: b200 rmi <이미지>'
    local who; who=$(image_table | awk -F'\t' -v r="$1" '$1==r {print $2}')
    if [ -n "$who" ] && [ "$who" != "$ME" ] && [ "$who" != '주인 없음' ] && ! is_root; then
        read -r -p "  $who 가 들여온 이미지예요. 그래도 지울까요? [y/N] " a; [ "$a" = y ] || exit 0
    fi
    docker_cmd rmi "$1" && ok "지웠어요: $1"
}

# ------------------------------------------------------------------ 기타
cmd_port() {
    need_me
    local idx p; idx=$(members | grep -nxF "$ME" | cut -d: -f1); idx=${idx:-0}
    p=$((PORT_BASE + idx * 10))
    echo "내 포트: $p ~ $((p + 9))  (같은 계정이라 포트가 겹치지 않게 사람마다 나눠요)"
    echo "  예) jupyter lab --no-browser --ip 127.0.0.1 --port $p"
    echo "      tensorboard --logdir runs --host 127.0.0.1 --port $((p + 1))"
    echo "  내 PC 브라우저로 보는 방법은 사용 안내의 'Jupyter·TensorBoard' 를 보세요."
}

cmd_du() {
    echo "작업 폴더 사용량 ($W)"
    du -sh "$W"/*/ 2>/dev/null | sort -rh | sed "s#$W/##; s#/\$##" | head -20 | sed 's/^/  /'
    if have_docker; then echo "도커 이미지 전체: $(docker_cmd system df --format '{{.Type}} {{.Size}}' 2>/dev/null | awk '$1=="Images" {print $2}')"; fi
    df -h "$APP" | awk 'NR==2 {print "디스크: "$3" 사용 / "$2" ("$5")"}'
}

cmd_doctor() {
    echo "== GPU"; nvidia-smi -L 2>&1 | head -8
    echo "== 공용 Python 환경 (GPU: ${CUDA_VISIBLE_DEVICES:-배정 안 됨 → 0번으로 시험})"
    CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0} "$S/venv/bin/python" -c 'import torch; n=torch.cuda.device_count(); [ (torch.randn(64,64,device=f"cuda:{i}")@torch.randn(64,64,device=f"cuda:{i}")).sum().item() for i in range(n)]; print("PyTorch", torch.__version__, "GPU", n, "장 계산 확인")' 2>&1 | tail -1
    if have_docker; then
        echo "== 도커"; docker_cmd info --format 'Docker {{.ServerVersion}}, {{.DockerRootDir}}' 2>&1 | tail -1
        [ $# -ge 1 ] && check_image "$1"
    fi
}

cmd_rules() { cat "$S/bin/rules.txt" 2>/dev/null || echo '규칙 파일이 없어요. 관리자에게 알려 주세요.'; }

cmd_help() {
    cat <<EOF
${c_b}b200${c_0}                          현황: GPU별 쓰는 사람, 디스크, 관리자 알림
${c_b}b200 run${c_0} <GPU> <명령>         학습 실행(끊겨도 계속)   예) b200 run auto python train.py
${c_b}b200 shell${c_0} [GPU]              GPU를 배정한 셸(실험·디버깅)   예) b200 shell auto:2
${c_b}b200 ps${c_0}                       내 작업 목록(번호, GPU, 상태)
${c_b}b200 attach${c_0} [번호]            내 작업 화면 보기(나오기: Ctrl+b 누른 뒤 d)
${c_b}b200 stop${c_0} [번호]              내 작업 멈추고 GPU 반납
${c_b}b200 docker${c_0} <GPU> <이미지> [명령]  컨테이너로 실행(명령 없으면 컨테이너 셸)
${c_b}b200 image-load${c_0} [파일|폴더]   도커 이미지 들여오기(기본: /app/inbox/images/내이름)
${c_b}b200 images${c_0} / ${c_b}rmi${c_0} <이미지>     이미지 목록 / 지우기
${c_b}b200 claim${c_0} <GPU>              우리 그룹 GPU를 빌려 간 사람에게 반납 요청(${BORROW_MINUTES}분 뒤 자동 종료)
${c_b}b200 port${c_0}                     내 Jupyter·TensorBoard 포트
${c_b}b200 du${c_0} / ${c_b}doctor${c_0} / ${c_b}rules${c_0}          사용량 / 점검 / 규칙
GPU 자리: auto(빈 GPU 1장), auto:2(2장)는 내 그룹·공용에서 골라요. 다른 그룹 GPU는 번호로(예: 4).
EOF
}

# ------------------------------------------------------------------ 내부(접속 설정·정기 점검이 부른다)
cmd__hello() {
    echo
    echo "${c_b}B200 서버${c_0}  공용 계정이라 이름으로 사람을 구분해요. 규칙: b200 rules"
    if nvidia-smi -L >/dev/null 2>&1; then
        local taken free; taken=" $(ME='' taken_by_others | tr '\n' ' ') "
        free=$(for i in $(seq 0 $(( $(gpu_count) - 1 ))); do case "$taken" in *" $i "*) ;; *) echo "$i" ;; esac; done | tr '\n' ' ')
        echo "  지금 빈 GPU: ${free:-없음}"
    fi
}

act() { echo "$(date '+%F %T') $*" >> "$ST/actions.log"; }

# 5분마다(root): GPU 사용 기록 + 자동 집행(반납 요청 마감, 누군지 모르는 작업)
cmd__log_gpu() {
    local f now procs seen alive; f="$ST/gpu_log/$(date +%Y-%m).tsv"; now=$(date +%s); procs=$(gpu_procs)
    echo "$procs" | while read -r g pid mem who; do
        [ -n "$pid" ] || continue
        grp=$(alloc_of "$g"); own=$(group_of "$who")
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$g" "$who" "${own:--}" "${grp:--}" "$mem" "$(ps -o args= -p "$pid" | cut -c1-60)"
    done >> "$f"
    # 반납 요청 마감: 빌린 사람의 b200 작업과 프로세스를 멈춘다
    if [ -f "$ST/claims.tsv" ]; then
        awk -F'\t' -v now="$now" '$4<=now && $4>now-3600' "$ST/claims.tsv" | while IFS=$'\t' read -r g req t0 t1; do
            grp=$(alloc_of "$g")
            sessions | awk -v g="$g" '$5!="끝남" {n=split($3,a,","); for(i=1;i<=n;i++) if(a[i]==g) print $1, $2}' | while read -r s u; do
                [ "$(group_of "$u")" = "$grp" ] && continue
                have_docker && docker_cmd stop "$s" >/dev/null 2>&1
                "${TMUXB[@]}" kill-session -t "=$s" 2>/dev/null && act "반납 요청 마감: GPU $g, $u 의 작업 $s 종료(요청 $req)"
            done
            echo "$procs" | awk -v g="$g" '$1==g {print $2, $4}' | while read -r pid u; do
                [ -n "$pid" ] || continue
                [ "$u" != '?' ] && [ "$(group_of "$u")" = "$grp" ] && continue
                kill "$pid" 2>/dev/null && act "반납 요청 마감: GPU $g, $u 의 프로세스 $pid 종료(요청 $req)"
            done
        done
        awk -F'\t' -v now="$now" '$4>now-3600' "$ST/claims.tsv" > "$ST/claims.tsv.new" && mv "$ST/claims.tsv.new" "$ST/claims.tsv"
    fi
    # 누군지 모르는 GPU 작업: 처음 본 시각을 적어 두고, 정한 시간이 지나면 멈춘다
    seen="$ST/unknown_seen.tsv"; touch "$seen"
    echo "$procs" | awk '$4=="?" {print $2}' | while read -r pid; do
        [ -n "$pid" ] || continue
        first=$(awk -F'\t' -v p="$pid" '$1==p {print $2}' "$seen")
        if [ -z "$first" ]; then printf '%s\t%s\n' "$pid" "$now" >> "$seen"
        elif [ $((now - first)) -ge $((UNKNOWN_KILL_MINUTES * 60)) ]; then
            cmd=$(ps -o args= -p "$pid" | cut -c1-60)
            kill "$pid" 2>/dev/null && act "누군지 모르는 GPU 작업 종료: pid $pid ($cmd), ${UNKNOWN_KILL_MINUTES}분 넘음"
        fi
    done
    alive=$(echo "$procs" | awk '$4=="?" {print $2}' | tr '\n' ' ')
    awk -F'\t' -v a=" $alive " 'index(a, " "$1" ")' "$seen" > "$seen.new" && mv "$seen.new" "$seen"
}

cmd__report() {    # root cron, 매일
    echo "B200 점검 보고서 $(date '+%F %T')"
    use=$(df -P "$APP" 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')
    [ "${use:-0}" -ge 80 ] && echo "[알림] 디스크 /app 이 ${use}% 찼어요. 많이 쓰는 사람부터 정리해 주세요(b200 du)."
    echo "== 사람별 작업 폴더"; du -sh "$W"/*/ 2>/dev/null | sort -rh | sed "s#$W/##" | head -20
    if have_docker; then
        local notice; notice=$(date -d "$IMAGE_NOTICE_DAYS days ago" +%F)
        image_table | while IFS=$'\t' read -r ref who last; do
            if [ "$last" = - ]; then echo "[알림] 주인 없는 이미지(b200 image-load 로 들여오지 않음): $ref"
            elif [[ "$last" < "$notice" ]]; then
                echo "[알림] $who 의 이미지 $ref: 마지막 사용 $last, $(date -d "$last + $IMAGE_DELETE_DAYS days" +%F)에 지워요"
            fi
        done
    fi
    echo "== 지난 하루 사람별 GPU 사용(5분 기록 수 ÷ 12 = GPU 시간)"
    awk -F'\t' -v since="$(date -d '1 day ago' '+%F %T')" '$1>=since {n[$3]++} END {for (u in n) printf "  %s %.1f\n", u, n[u]/12}' \
        "$ST/gpu_log/$(date +%Y-%m).tsv" 2>/dev/null
    echo "== 지난 하루 자동 집행"
    awk -v since="$(date -d '1 day ago' '+%F %T')" '($1" "$2)>=since' "$ST/actions.log" 2>/dev/null | sed 's/^/  /'
    echo "== GPU 오류"
    nvidia-smi -q -d ECC 2>/dev/null | grep -iE 'uncorr.*: [1-9]' | head -5 | sed 's/^/[알림] ECC 오류: /'
    journalctl -k --since '1 day ago' 2>/dev/null | grep -i 'NVRM: Xid' | tail -5 | sed 's/^/[알림] /'
    true
}

# 관리자: 삭제 예정일이 지난 이미지를 한 번에 지운다(확인 후)
cmd__cleanup_images() {
    is_root || die '관리자(root)만 써요.'
    local today o; today=$(date +%F)
    mapfile -t old < <(image_table | while IFS=$'\t' read -r ref who last; do
        [ "$last" != - ] && [[ "$(date -d "$last + $IMAGE_DELETE_DAYS days" +%F)" < "$today" ]] && echo "$ref ($who, 마지막 $last)"; done)
    [ ${#old[@]} -gt 0 ] || { ok '지울 이미지가 없어요.'; return; }
    printf '  %s\n' "${old[@]}"
    read -r -p "  위 ${#old[@]}개를 지울까요? [y/N] " a; [ "$a" = y ] || return
    for o in "${old[@]}"; do docker_cmd rmi "${o%% *}" >/dev/null && act "오래된 이미지 삭제: $o"; done
    ok '지웠어요.'
}

case "${1:-}" in
    ''|status)   cmd_status ;;
    run)         shift; cmd_run "$@" ;;
    shell)       shift; cmd_shell "$@" ;;
    docker)      shift; cmd_docker "$@" ;;
    ps)          cmd_ps ;;
    attach)      shift; cmd_attach "$@" ;;
    stop)        shift; cmd_stop "$@" ;;
    claim)       shift; cmd_claim "$@" ;;
    image-load)  shift; cmd_image_load "$@" ;;
    images)      cmd_images ;;
    rmi)         shift; cmd_rmi "$@" ;;
    port)        cmd_port ;;
    du)          cmd_du ;;
    doctor)      shift; cmd_doctor "$@" ;;
    rules)       cmd_rules ;;
    help|-h|--help) cmd_help ;;
    _hello)      cmd__hello ;;
    _is-member)  is_member "${2:-}" ;;
    _names)      members | tr '\n' ' ' ;;
    _log-gpu)    cmd__log_gpu ;;
    _report)     cmd__report ;;
    _cleanup-images) cmd__cleanup_images ;;
    *)           echo "모르는 명령: $1"; cmd_help; exit 1 ;;
esac
